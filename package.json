{
  "name": "ember-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify-totals": "node scripts/verify-totals.mjs",
    "build-checklist": "node scripts/verify-totals.mjs --write",
    "dev:full": "npm run build && wrangler pages dev dist --port 5174",
    "db:local": "wrangler d1 execute ember --local --file schema.sql",
    "db:remote": "wrangler d1 execute ember --remote --file schema.sql",
    "addresses": "node scripts/read-addresses.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name ember",
    "announce": "node scripts/announce.mjs",
    "telegram:webhook": "node scripts/telegram-webhook.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
